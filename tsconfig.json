{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "resolveJsonModule": true,
    "rootDir": "./src",
    "outDir": "./module/",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "strict": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "declarationMap": true,
    "types": ["node"]
  },
  "include": ["src/"],
  "exclude": ["__tests/**/*.test.ts"]
}
