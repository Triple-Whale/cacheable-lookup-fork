{
  "name": "@tw/cacheable-lookup",
  "version": "1.5.0",
  "description": "A cacheable dns.lookup(…) that respects TTL",
  "main": "module/index.js",
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "npm i && tsc",
    "deploy": "tw publish utils",
    "test": "tsc && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "typescript": "^4.9.5"
  },
  "ava": {
    "nodeArguments": [
      "--loader=quibble"
    ]
  },
  "xo": {
    "rules": {
      "unicorn/import-index": "off",
      "import/extensions": "off",
      "import/no-useless-path-segments": "off"
    }
  },
  "dependencies": {
    "lru-cache": "^11.2.2"
  }
}
